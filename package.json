{
  "name": "jev-review",
  "version": "0.1.0",
  "description": "A small staged code-review workflow built with TypeSafe Jev.",
  "private": true,
  "license": "MIT",
  "repository": "github:devagrawal09/jev-review",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "review:changes": "node --env-file=.env --experimental-strip-types src/cli/review-changes.ts",
    "review:changes:save": "node --env-file=.env --experimental-strip-types src/cli/save-changes.ts",
    "review:codebase": "node --env-file=.env --experimental-strip-types src/cli/review-codebase.ts",
    "review:codebase:save": "node --env-file=.env --experimental-strip-types src/cli/save-codebase.ts",
    "dashboard": "node --experimental-strip-types src/dashboard/server.ts",
    "typecheck": "tsc --noEmit",
    "check:deps": "node --experimental-strip-types scripts/check-dependencies.ts",
    "check": "npm run typecheck && npm run check:deps && node --check src/dashboard/public/app.js"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
